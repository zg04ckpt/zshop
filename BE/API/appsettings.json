{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Redis": {
    "EndPoints": {
      "Default": "redis"
    },
    "Ssl": false,
    "ConnectTimeout": 5000,
    "SyncTimeout": 5000,
    "ConnectRetry": 4
  },
  "JwtConfig": {
    "Audience": "[host]",
    "Issuer": "[host]",
    "AccessTokenTTL": 50,
    "RefreshTokenTTL": 120
  },
  "GoogleLoginConfig": {
    "CallbackPath": "/api/v1/auth/google-callback"
  },
  "AuthConfig": {
    "MaxFailedAttempts": 5,
    "ConfirmEmailAuthCodeTTL": 40,
    "ResetPassAuthCodeTTL": 40,
    "LoginLockFlagTTL": 1,
    "OAuthLoginDataMinutesTTL": 2
  },
  "MailConfig": {
    "Host": "smtp.gmail.com",
    "Port": 587
  },
  "AllowedHosts": {
    "Web": "[host]"
  },
  "VNPayConfig": {
    "vnp_Url": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "vnp_Version": "2.1.0",
    "vnp_Command": "pay",
    "vnp_TmnCode": "--",
    "vnp_CurrCode": "VND",
    "vnp_Locale": "vn",
    "vnp_OrderType": "billpayment",
    "vnp_ReturnUrl": "https://[host]/api/v1/payment/vnp-result"
  },
  "PaymentConfig": {
    "ExpireInMinutes": 4,
    "ClientHomeUrl": "--"
  }
}
